import tkinter as tk
from tkinter import messagebox
import random

class Game2048:
    def __init__(self, master):
        self.master = master
        self.master.title("2048")
        self.master.geometry("420x500")
        self.master.resizable(False, False)

        self.grid_size = 4
        self.grid = [[0] * self.grid_size for _ in range(self.grid_size)]
        self.score = 0

        self.create_ui()
        self.add_tile()
        self.add_tile()
        self.update_grid()

        self.master.bind("<Key>", self.handle_key)

    def create_ui(self):
        self.score_label = tk.Label(self.master, text=f"Score: {self.score}", font=("Helvetica", 18))
        self.score_label.pack(pady=10)

        self.board_frame = tk.Frame(self.master, bg='gray')
        self.board_frame.pack()

        self.tiles = []
        for i in range(self.grid_size):
            row = []
            for j in range(self.grid_size):
                tile = tk.Label(self.board_frame, text="", font=("Helvetica", 28, "bold"),
                                width=4, height=2, borderwidth=2, relief="groove", bg="lightgray")
                tile.grid(row=i, column=j, padx=5, pady=5)
                row.append(tile)
            self.tiles.append(row)

        self.restart_button = tk.Button(self.master, text="Restart", font=("Helvetica", 14),
                                        command=self.restart_game)
        self.restart_button.pack(pady=10)

    def add_tile(self):
        empty_cells = [(i, j) for i in range(self.grid_size) for j in range(self.grid_size) if self.grid[i][j] == 0]
        if empty_cells:
            i, j = random.choice(empty_cells)
            self.grid[i][j] = 2 if random.random() < 0.9 else 4

    def update_grid(self):
        self.score_label.config(text=f"Score: {self.score}")
        for i in range(self.grid_size):
            for j in range(self.grid_size):
                value = self.grid[i][j]
                if value == 0:
                    self.tiles[i][j].config(text="", bg="lightgray")
                else:
                    self.tiles[i][j].config(text=str(value), bg=self.get_color(value))

    def handle_key(self, event):
        if event.keysym in ['Up', 'Down', 'Left', 'Right']:
            old_grid = [row[:] for row in self.grid]
            self.move_tiles(event.keysym)
            if self.grid != old_grid:
                self.add_tile()
                self.update_grid()
                if self.check_game_over():
                    messagebox.showinfo("Game Over", f"Game Over!\nYour Score: {self.score}")
                    self.master.unbind("<Key>")

    def move_tiles(self, direction):
        def compress(row):
            new_row = [i for i in row if i != 0]
            new_row += [0] * (self.grid_size - len(new_row))
            return new_row

        def merge(row):
            for i in range(self.grid_size - 1):
                if row[i] != 0 and row[i] == row[i + 1]:
                    row[i] *= 2
                    self.score += row[i]
                    row[i + 1] = 0
            return row

        for _ in range({'Up': 1, 'Down': 3, 'Left': 0, 'Right': 2}[direction]):
            self.grid = self.transpose(self.grid)
        if direction in ['Right', 'Down']:
            self.grid = self.reverse(self.grid)

        new_grid = []
        for row in self.grid:
            compressed = compress(row)
            merged = merge(compressed)
            final = compress(merged)
            new_grid.append(final)

        self.grid = new_grid

        if direction in ['Right', 'Down']:
            self.grid = self.reverse(self.grid)
        for _ in range({'Up': 3, 'Down': 1, 'Left': 0, 'Right': 2}[direction]):
            self.grid = self.transpose(self.grid)

    def check_game_over(self):
        for i in range(self.grid_size):
            for j in range(self.grid_size):
                if self.grid[i][j] == 0:
                    return False
                if j < self.grid_size - 1 and self.grid[i][j] == self.grid[i][j + 1]:
                    return False
                if i < self.grid_size - 1 and self.grid[i][j] == self.grid[i + 1][j]:
                    return False
        return True

    def restart_game(self):
        self.grid = [[0] * self.grid_size for _ in range(self.grid_size)]
        self.score = 0
        self.add_tile()
        self.add_tile()
        self.update_grid()
        self.master.bind("<Key>", self.handle_key)

    @staticmethod
    def transpose(matrix):
        return [list(row) for row in zip(*matrix)]

    @staticmethod
    def reverse(matrix):
        return [row[::-1] for row in matrix]

    def get_color(self, value):
        colors = {
            2: "#eee4da", 4: "#ede0c8", 8: "#f2b179",
            16: "#f59563", 32: "#f67c5f", 64: "#f65e3b",
            128: "#edcf72", 256: "#edcc61", 512: "#edc850",
            1024: "#edc53f", 2048: "#edc22e"
        }
        return colors.get(value, "#3c3a32")

def main():
    root = tk.Tk()
    Game2048(root)
    root.mainloop()

if __name__ == "__main__":
    main()
